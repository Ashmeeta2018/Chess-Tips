{
	"name": "chess-tips",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:cdrive": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-with-cdrive-cache.ps1 dev --host 127.0.0.1 --port 4173",
		"build": "tsc -b && vite build",
		"build:cdrive": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-with-cdrive-cache.ps1 build",
		"lint": "oxlint",
		"preview": "vite preview",
		"mock:sync": "node scripts/mock-cloud-sync-server.mjs",
		"test:sync-contract": "node --test tests/mock-cloud-sync-contract.test.mjs"
	},
	"dependencies": {
		"chess.js": "^1.4.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"oxlint": "^1.81.0",
		"typescript": "~6.0.2",
		"vite": "^8.3.0"
	}
}
